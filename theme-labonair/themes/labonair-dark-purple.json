	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#6C7380",
				"fontStyle": ""
			}
		},
		{
			"name": "String",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#AAD94C"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#D2A6FF"
			}
		},
		{
			"name": "Built-in constant",
			"scope": [
				"constant.language"
			],
			"settings": {
				"foreground": "#D2A6FF"
			}
		},
		{
			"name": "User-defined constant",
			"scope": [
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#D2A6FF"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable"
			],
			"settings": {
				"fontStyle": ""
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword"
			],
			"settings": {
				"foreground": "#FF8F40"
			}
		},
		{
			"name": "Storage",
			"scope": [
				"storage"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#FF8F40"
			}
		},
		{
			"name": "Storage type",
			"scope": [
				"storage.type"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#FF8F40"
			}
		},
		{
			"name": "Class name",
			"scope": [
				"entity.name.class"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#39BAE6"
			}
		},
		{
			"name": "Inherited class",
			"scope": [
				"entity.other.inherited-class"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#39BAE6"
			}
		},
		{
			"name": "Function name",
			"scope": [
				"entity.name.function"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#9046FE"
			}
		},
		{
			"name": "Function argument",
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#BFBDB6"
			}
		},
		{
			"name": "Tag name",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#39BAE6"
			}
		},
		{
			"name": "Tag attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#9046FE"
			}
		},
		{
			"name": "Library function",
			"scope": [
				"support.function"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#9046FE"
			}
		},
		{
			"name": "Library constant",
			"scope": [
				"support.constant"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#D2A6FF"
			}
		},
		{
			"name": "Library class/type",
			"scope": [
				"support.type",
				"support.class"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#39BAE6"
			}
		},
		{
			"name": "Library variable",
			"scope": [
				"support.other.variable"
			],
			"settings": {
				"fontStyle": ""
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#FF0055"
			}
		},
		{
			"name": "Invalid deprecated",
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#FF0055"
			}
		},
		{
			"name": "Markup Quote",
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#39BAE6"
			}
		},
		{
			"name": "Markup List",
			"scope": [
				"markup.list"
			],
			"settings": {
				"foreground": "#F26D78"
			}
		},
		{
			"name": "Markup Code",
			"scope": [
				"markup.code"
			],
			"settings": {
				"background": "#2B2B2B"
			}
		},
		{
			"name": "Markup Code",
			"scope": [
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#AAD94C"
			}
		},
		{
			"name": "Markup Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#FF8F40"
			}
		},
		{
			"name": "Markup Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#FF8F40"
			}
		},
		{
			"name": "Markup Bold Italic",
			"scope": [
				"markup.bold markup.italic",
				"markup.italic markup.bold"
			],
			"settings": {
				"fontStyle": "bold italic",
				"foreground": "#FF8F40"
			}
		},
		{
			"name": "Markup Underline",
			"scope": [
				"markup.underline"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"name": "Markup Heading",
			"scope": [
				"markup.heading"
			],
			"settings": {
				"foreground": "#9046FE"
			}
		},
		{
			"name": "Markup Heading Punctuation",
			"scope": [
				"markup.heading punctuation.definition.heading"
			],
			"settings": {
				"foreground": "#9046FE"
			}
		},
		{
			"name": "Markup Horizontal Rule",
			"scope": [
				"markup.hr"
			],
			"settings": {
				"foreground": "#39BAE6"
			}
		},
		{
			"name": "Markup Link",
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#39BAE6"
			}
		},
		{
			"name": "Markup Link Label",
			"scope": [
				"string.other.link.title.markdown"
			],
			"settings": {
				"foreground": "#9046FE"
			}
		},
		{
			"name": "Markup Link URL",
			"scope": [
				"markup.underline.link.image.markdown"
			],
			"settings": {
				"foreground": "#D2A6FF"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"function": "#9046FE",
		"method": "#9046FE",
		"variable.readonly": "#D2A6FF",
		"parameter": "#BFBDB6",
		"property": "#F07178"
	}
}
