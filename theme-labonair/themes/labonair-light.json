	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#999999",
				"fontStyle": ""
			}
		},
		{
			"name": "String",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#5C7C1F"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#7B3FF2"
			}
		},
		{
			"name": "Built-in constant",
			"scope": [
				"constant.language"
			],
			"settings": {
				"foreground": "#7B3FF2"
			}
		},
		{
			"name": "User-defined constant",
			"scope": [
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#7B3FF2"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable"
			],
			"settings": {
				"fontStyle": ""
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword"
			],
			"settings": {
				"foreground": "#D45113"
			}
		},
		{
			"name": "Storage",
			"scope": [
				"storage"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#D45113"
			}
		},
		{
			"name": "Storage type",
			"scope": [
				"storage.type"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#D45113"
			}
		},
		{
			"name": "Class name",
			"scope": [
				"entity.name.class"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#0B5394"
			}
		},
		{
			"name": "Inherited class",
			"scope": [
				"entity.other.inherited-class"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#0B5394"
			}
		},
		{
			"name": "Function name",
			"scope": [
				"entity.name.function"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#D68A38"
			}
		},
		{
			"name": "Function argument",
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#333333"
			}
		},
		{
			"name": "Tag name",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#0B5394"
			}
		},
		{
			"name": "Tag attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#D68A38"
			}
		},
		{
			"name": "Library function",
			"scope": [
				"support.function"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#D68A38"
			}
		},
		{
			"name": "Library constant",
			"scope": [
				"support.constant"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#7B3FF2"
			}
		},
		{
			"name": "Library class/type",
			"scope": [
				"support.type",
				"support.class"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#0B5394"
			}
		},
		{
			"name": "Library variable",
			"scope": [
				"support.other.variable"
			],
			"settings": {
				"fontStyle": ""
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#E32D27"
			}
		},
		{
			"name": "Invalid deprecated",
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#E32D27"
			}
		},
		{
			"name": "Markup Quote",
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#0B5394"
			}
		},
		{
			"name": "Markup List",
			"scope": [
				"markup.list"
			],
			"settings": {
				"foreground": "#E32D27"
			}
		},
		{
			"name": "Markup Code",
			"scope": [
				"markup.code"
			],
			"settings": {
				"background": "#E8E8E8"
			}
		},
		{
			"name": "Markup Code",
			"scope": [
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#5C7C1F"
			}
		},
		{
			"name": "Markup Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#D45113"
			}
		},
		{
			"name": "Markup Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#D45113"
			}
		},
		{
			"name": "Markup Bold Italic",
			"scope": [
				"markup.bold markup.italic",
				"markup.italic markup.bold"
			],
			"settings": {
				"fontStyle": "bold italic",
				"foreground": "#D45113"
			}
		},
		{
			"name": "Markup Underline",
			"scope": [
				"markup.underline"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"name": "Markup Heading",
			"scope": [
				"markup.heading"
			],
			"settings": {
				"foreground": "#D68A38"
			}
		},
		{
			"name": "Markup Heading Punctuation",
			"scope": [
				"markup.heading punctuation.definition.heading"
			],
			"settings": {
				"foreground": "#D68A38"
			}
		},
		{
			"name": "Markup Horizontal Rule",
			"scope": [
				"markup.hr"
			],
			"settings": {
				"foreground": "#0B5394"
			}
		},
		{
			"name": "Markup Link",
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#0B5394"
			}
		},
		{
			"name": "Markup Link Label",
			"scope": [
				"string.other.link.title.markdown"
			],
			"settings": {
				"foreground": "#D68A38"
			}
		},
		{
			"name": "Markup Link URL",
			"scope": [
				"markup.underline.link.image.markdown"
			],
			"settings": {
				"foreground": "#7B3FF2"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"function": "#D68A38",
		"method": "#D68A38",
		"variable.readonly": "#7B3FF2",
		"parameter": "#333333",
		"property": "#D32852"
	}
}
